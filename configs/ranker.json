{
  "model": {
    "objective": "lambdarank",
    "label_gain": [0, 1, 3],
    "metric": "ndcg",
    "n_estimators": 300,
    "learning_rate": 0.05,
    "num_leaves": 15,
    "min_child_samples": 30,
    "reg_lambda": 1.0,
    "random_state": 42,
    "n_jobs": 4,
    "deterministic": true,
    "force_col_wise": true,
    "verbosity": -1
  },
  "early_stopping_rounds": 30,
  "parameter_policy": "Single fixed configuration before T8 validation/test; early stop on validation NDCG@10 only"
}
